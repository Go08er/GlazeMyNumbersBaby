  <project_license>MIT AND OFL-1.1</project_license>
  <name>DGMNB</name>
  <summary>Don't Glaze My Numbers, Baby — a lean, plain calculator</summary>
  <description>
    <p>
      DGMNB is the lean twin of GMNB: the same Rust port of the open-source
      Windows Calculator, with every mode and feature, drawn in software with
      a plain interface instead of a glossy one. It needs no GPU, uses around
      13 MB of memory and does nothing at all while it waits for you.
    </p>
    <ul>
      <li>Standard, Scientific and Programmer calculators with history and memory</li>
      <li>Graphing with variables, tracing and function analysis</li>
      <li>Date calculation and unit conversion for 13 categories, including live currency rates</li>
      <li>Light and dark styles that follow your desktop, and its accent colour</li>
    </ul>
    <p>
      Not affiliated with or endorsed by Microsoft. Based on microsoft/calculator (MIT).
    </p>
  </description>
  <launchable type="desktop-id">io.github.Go08er.DontGlazeMyNumbersBaby.desktop</launchable>
