{
  "id": "io.github.Go08er.DontGlazeMyNumbersBaby",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "26.08",
  "sdk": "org.freedesktop.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable"
  ],
  "command": "dgmnb",
  "finish-args": [
    "--share=ipc",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--share=network",
    "--system-talk-name=org.freedesktop.timedate1"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin",
    "env": {
      "CARGO_HOME": "/run/build/dgmnb/cargo",
      "CARGO_NET_OFFLINE": "true"
    }
  },
  "cleanup": [
    "/share/doc"
  ],
  "modules": [
    {
      "name": "dgmnb",
      "buildsystem": "simple",
      "build-commands": [
        "cargo --offline fetch --manifest-path Cargo.toml",
        "cargo --offline build --profile lean --locked -p dgmnb",
        "install -Dm755 target/lean/dgmnb -t /app/bin",
        "install -Dm644 packaging/io.github.Go08er.DontGlazeMyNumbersBaby.desktop -t /app/share/applications",
        "install -Dm644 packaging/io.github.Go08er.DontGlazeMyNumbersBaby.metainfo.xml -t /app/share/metainfo",
        "install -Dm644 packaging/icons/io.github.Go08er.DontGlazeMyNumbersBaby.svg -t /app/share/icons/hicolor/scalable/apps",
        "install -Dm644 LICENSE apps/dgmnb/assets/fonts/OFL-Inter.txt apps/dgmnb/assets/fonts/OFL-Noto.txt -t /app/share/licenses/io.github.Go08er.DontGlazeMyNumbersBaby"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/Go08er/GlazeMyNumbersBaby.git",
          "tag": "v0.2.0"
        },
        "cargo-sources.json"
      ]
    }
  ]
}
