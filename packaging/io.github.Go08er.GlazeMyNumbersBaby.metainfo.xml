  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT AND OFL-1.1</project_license>
  <name>GMNB</name>
  <summary>GlazeMyNumbers,Baby — a pointlessly beautiful calculator</summary>
  <description>
    <p>
      GMNB (GlazeMyNumbers,Baby) is a Rust port of the open-source Windows
      Calculator with a GTK 4 interface that is considerably prettier than it
      needs to be. The original arbitrary-precision engine was ported
      function-for-function and is verified against the real C++ engine.
    </p>
    <ul>
      <li>Standard, Scientific and Programmer calculators with history and memory</li>
      <li>Graphing with variables, tracing and function analysis</li>
      <li>Date calculation and unit conversion for 13 categories, including live currency rates</li>
      <li>Seven colour palettes in light and dark — including one that follows your desktop's accent colour and one you design yourself — and a background that blooms when you type</li>
    </ul>
    <p>
      Not affiliated with or endorsed by Microsoft. Based on microsoft/calculator (MIT).
    </p>
  </description>
  <launchable type="desktop-id">io.github.Go08er.GlazeMyNumbersBaby.desktop</launchable>
  <provides>
    <binary>gmnb</binary>
  </provides>
