# Maintainer: Go08er <https://github.com/Go08er>
pkgname=gmnb
pkgver=0.1.0
pkgrel=1
pkgdesc='GlazeMyNumbers,Baby: Windows Calculator ported to Rust, made pointlessly beautiful'
arch=('x86_64' 'aarch64')
url='https://github.com/Go08er/GlazeMyNumbersBaby'
license=('MIT' 'OFL-1.1')
depends=('gtk4' 'libadwaita' 'glib2' 'pango' 'cairo' 'gcc-libs' 'glibc' 'hicolor-icon-theme')
makedepends=('cargo')
# Rust handles its own LTO; makepkg's -flto would also hit the bundled C (ring).
options=('!lto' '!debug')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('c467480457b9fa79fa4df9cf5dfe91f4599f3a7f9ef3e70c6a86951a5028390b')

_appid=io.github.Go08er.GlazeMyNumbersBaby

prepare() {
  cd "GlazeMyNumbersBaby-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "GlazeMyNumbersBaby-$pkgver"
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  cargo build --frozen --release -p gmnb
}

check() {
  cd "GlazeMyNumbersBaby-$pkgver"
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  cargo test --frozen --release --workspace --exclude gmnb
}

package() {
  cd "GlazeMyNumbersBaby-$pkgver"
  install -Dm755 target/release/gmnb -t "$pkgdir/usr/bin"
  install -Dm644 "packaging/$_appid.desktop" -t "$pkgdir/usr/share/applications"
  install -Dm644 "packaging/$_appid.metainfo.xml" -t "$pkgdir/usr/share/metainfo"
  install -Dm644 "packaging/icons/$_appid.svg" -t "$pkgdir/usr/share/icons/hicolor/scalable/apps"
  install -Dm644 LICENSE app/assets/fonts/OFL-Outfit.txt -t "$pkgdir/usr/share/licenses/$pkgname"
}
