#!/usr/bin/make -f
# Needs `cargo` (Rust >= 1.92) on PATH; Debian 13's rustc is too old, so use rustup.

APP := io.github.Go08er.GlazeMyNumbersBaby
PKG := debian/gmnb

%:
	dh $@

override_dh_auto_configure:

override_dh_auto_build:
	cargo build --release --locked -p gmnb

override_dh_auto_test:

override_dh_auto_install:
	install -Dm755 target/release/gmnb $(PKG)/usr/bin/gmnb
	install -Dm644 packaging/$(APP).desktop $(PKG)/usr/share/applications/$(APP).desktop
	install -Dm644 packaging/$(APP).metainfo.xml $(PKG)/usr/share/metainfo/$(APP).metainfo.xml
	install -Dm644 packaging/icons/$(APP).svg $(PKG)/usr/share/icons/hicolor/scalable/apps/$(APP).svg

override_dh_auto_clean:
	rm -rf target

# Rust binaries are already stripped of DWARF by the release profile.
override_dh_dwz:
